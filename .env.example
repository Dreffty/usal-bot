# ---------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------
# Token que te da @BotFather al crear el bot
TELEGRAM_TOKEN=123456:ABC-DEF...

# Tu id numerico de Telegram (te lo dice @userinfobot).
# Solo estos ids pueden hablar con el bot. Separa por comas si hay varios.
TELEGRAM_ALLOWED_IDS=123456789

# ---------------------------------------------------------------
# Studium (Moodle de la USAL)
# ---------------------------------------------------------------
STUDIUM_URL=https://studium.usal.es
# Se rellena solo al ejecutar:  python setup_wizard.py studium
STUDIUM_TOKEN=

# Alternativa a la clave, para cuando la universidad no deja crearlas (es el
# caso de la USAL). Es la direccion que da Studium en:
#   Calendario -> Exportar calendario -> Obtener URL del calendario
# Se rellena sola con:  python setup_wizard.py studium
STUDIUM_ICAL_URL=

# ---------------------------------------------------------------
# Correo
# ---------------------------------------------------------------
# gmail  -> API de Google con OAuth (recomendado, el correo USAL es Google)
# imap   -> servidor IMAP generico con usuario y contrasena
# none   -> sin correo, solo tareas
MAIL_BACKEND=gmail

# Solo si MAIL_BACKEND=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu.correo@usal.es
IMAP_PASSWORD=

# ---------------------------------------------------------------
# Capa de lenguaje natural (OPCIONAL)
# Sin esto el bot sigue entendiendo preguntas normales con sus reglas.
# Sirve cualquier endpoint compatible con OpenAI (NVIDIA NIM es gratis).
# ---------------------------------------------------------------
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=zai/glm-5.2

# Resumir los correos importantes con el modelo, para saber de que van sin
# abrirlos. Esto SI manda el cuerpo de esos correos (solo los marcados como
# importantes) al proveedor del modelo.
#   si -> resumen del modelo, y si falla, uno sacado del propio texto
#   no -> nada sale de tu ordenador; el resumen se saca del texto y ya
RESUMIR_CORREOS=si

# ---------------------------------------------------------------
# Comportamiento
# ---------------------------------------------------------------
# Cada cuantos minutos mira Studium y el correo
SYNC_MINUTES=10
# Puntos a partir de los cuales un correo cuenta como importante
SCORE_CLAVE=7
# Hora del resumen diario (24h, hora local). Vacio = sin resumen diario.
DAILY_DIGEST_AT=08:00
# Zona horaria
TIMEZONE=Europe/Madrid
DB_PATH=usalbot.db
